/* Dark Theme - Commercial Instrument Grade */
QMainWindow {
    background-color: #0F172A;
    font-family: "Microsoft YaHei UI", "Microsoft YaHei", "Segoe UI", Arial, sans-serif;
}

QWidget {
    font-size: 14px;
    color: #E5E7EB;
}

/* Group Boxes / Cards */
QGroupBox {
    background-color: #1E293B;
    border: 1px solid #334155;
    border-radius: 12px;
    margin-top: 24px;
    font-weight: 600;
    color: #E5E7EB;
    padding-top: 16px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 10px;
    background-color: transparent;
    font-size: 15px;
}

/* Inputs and Comboboxes */
QLineEdit, QComboBox {
    background-color: #0F172A;
    border: 1px solid #334155;
    border-radius: 8px;
    padding: 8px 12px;
    color: #E5E7EB;
    min-height: 20px;
}

QLineEdit:focus, QComboBox:focus {
    border: 1px solid #3B82F6;
    outline: none;
    background-color: #111827;
}

QLineEdit:disabled, QComboBox:disabled {
    background-color: #1E293B;
    color: #64748B;
}

/* Buttons */
QPushButton {
    background-color: #334155;
    border: 1px solid #475569;
    border-radius: 8px;
    padding: 10px 16px;
    color: #E5E7EB;
    font-weight: 600;
    min-height: 20px;
}

QPushButton:hover {
    background-color: #475569;
}

QPushButton:pressed {
    background-color: #1E293B;
}

QPushButton:disabled {
    background-color: #1E293B;
    color: #64748B;
}

/* Primary Action Button (Connect) */
QPushButton#btnConnect {
    background-color: #3B82F6;
    border: none;
    color: #FFFFFF;
}

QPushButton#btnConnect:hover {
    background-color: #60A5FA;
}

QPushButton#btnConnect:pressed {
    background-color: #2563EB;
}

/* Danger Action Button (Disconnect) */
QPushButton#btnDisconnect {
    background-color: #EF4444;
    border: none;
    color: #FFFFFF;
}

QPushButton#btnDisconnect:hover {
    background-color: #F87171;
}

QPushButton#btnDisconnect:pressed {
    background-color: #DC2626;
}

/* Status Bar */
QStatusBar {
    background-color: #1E293B;
    border-top: 1px solid #334155;
    color: #94A3B8;
    font-size: 13px;
}

/* Channel Value Cards */
QWidget#valCard {
    background-color: #1E293B;
    border: 1px solid #334155;
    border-radius: 12px;
}

QLabel.channel-title {
    font-size: 14px;
    color: #94A3B8;
    font-weight: 600;
}

QLabel.channel-value {
    font-family: "Segoe UI", "Roboto Mono", Consolas, monospace;
    font-size: 28px;
    font-weight: bold;
    color: #F8FAFC;
}

QLabel.channel-unit {
    font-size: 14px;
    color: #94A3B8;
    font-weight: bold;
}

/* Theme Toggle Button */
QPushButton#btnThemeToggle {
    background-color: transparent;
    border: 1px solid #334155;
    color: #94A3B8;
}

QPushButton#btnThemeToggle:hover {
    background-color: #334155;
}

/* Tab Widget */
QTabWidget::pane {
    border: 1px solid #334155;
    background: #1E293B;
    border-radius: 12px;
    padding: 8px;
}

QTabBar::tab {
    background: #0F172A;
    border: 1px solid #334155;
    border-bottom-color: #334155;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    min-width: 120px;
    padding: 10px 16px;
    margin-right: 4px;
    color: #94A3B8;
    font-weight: 600;
}

QTabBar::tab:selected, QTabBar::tab:hover {
    background: #1E293B;
    color: #60A5FA;
    border-bottom-color: #1E293B;
}

/* Alarm Cards */
QWidget#alarmCard {
    background-color: #1E293B;
    border: 1px solid #334155;
    border-radius: 8px;
}

QLabel.alarm-title {
    font-size: 15px;
    font-weight: bold;
    color: #F8FAFC;
}

QLabel.alarm-desc {
    font-size: 13px;
    color: #94A3B8;
}

QLabel.alarm-status-normal {
    font-weight: bold;
    color: #22C55E;
}

QLabel.alarm-status-warning {
    font-weight: bold;
    color: #FBBF24;
}

QLabel.alarm-status-danger {
    font-weight: bold;
    color: #F87171;
}

QLabel.alarm-status-unconfigured {
    font-weight: bold;
    color: #64748B;
}