/* Light Theme - Commercial Instrument Dashboard */
QMainWindow {
    background-color: #F4F7FB;
    font-family: "Microsoft YaHei UI", "Microsoft YaHei", "Segoe UI", Arial, sans-serif;
}

QWidget {
    font-size: 14px;
    color: #0F172A;
}

/* Scroll Area */
QScrollArea {
    border: none;
    background-color: transparent;
}
QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

/* Group Boxes / Cards */
QGroupBox {
    background-color: #FFFFFF;
    border: 1px solid #DDE5F0;
    border-radius: 12px;
    margin-top: 24px;
    font-weight: bold;
    color: #0F172A;
    padding-top: 16px;
    padding-bottom: 8px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 10px;
    background-color: transparent;
    font-size: 15px;
    color: #0F172A;
}

/* Base Cards */
.Card {
    background-color: #FFFFFF;
    border: 1px solid #DDE5F0;
    border-radius: 12px;
}

/* Inputs and Comboboxes */
QLineEdit, QComboBox {
    background-color: #F8FAFC;
    border: 1px solid #CBD5E1;
    border-radius: 8px;
    padding: 8px 12px;
    color: #0F172A;
    min-height: 20px;
}

QLineEdit:focus, QComboBox:focus {
    border: 1px solid #2563EB;
    outline: none;
    background-color: #FFFFFF;
}

QLineEdit:disabled, QComboBox:disabled {
    background-color: #E2E8F0;
    color: #94A3B8;
}

/* Buttons */
QPushButton {
    background-color: #F1F5F9;
    border: 1px solid #DDE5F0;
    border-radius: 8px;
    padding: 10px 16px;
    color: #0F172A;
    font-weight: 600;
    min-height: 20px;
}

QPushButton:hover {
    background-color: #E2E8F0;
}

QPushButton:pressed {
    background-color: #CBD5E1;
}

QPushButton:disabled {
    background-color: #F1F5F9;
    color: #94A3B8;
}

/* Primary Action Button (Connect) */
QPushButton#btnConnect {
    background-color: #2563EB;
    border: none;
    color: #FFFFFF;
}

QPushButton#btnConnect:hover {
    background-color: #1D4ED8;
}

QPushButton#btnConnect:pressed {
    background-color: #1E40AF;
}

/* Danger Action Button (Disconnect) */
QPushButton#btnDisconnect {
    background-color: #DC2626;
    border: none;
    color: #FFFFFF;
}

QPushButton#btnDisconnect:hover {
    background-color: #B91C1C;
}

QPushButton#btnDisconnect:pressed {
    background-color: #991B1B;
}

/* Status Bar */
QStatusBar {
    background-color: #FFFFFF;
    border-top: 1px solid #DDE5F0;
    color: #475569;
    font-size: 13px;
}

/* Channel Value Cards */
QWidget#valCard {
    background-color: #F8FAFC;
    border: 1px solid #DDE5F0;
    border-radius: 8px;
}

QLabel.channel-title {
    font-size: 14px;
    color: #475569;
    font-weight: 600;
}

QLabel.channel-value {
    font-family: "Segoe UI", "Roboto Mono", Consolas, monospace;
    font-size: 24px;
    font-weight: bold;
    color: #0F172A;
}

QLabel.channel-unit {
    font-size: 13px;
    color: #475569;
    font-weight: bold;
}

/* Header Text */
QLabel#headerTitle {
    font-size: 26px;
    font-weight: bold;
    color: #0F172A;
}

QLabel#headerSubtitle {
    font-size: 14px;
    color: #475569;
}

/* Status Capsule */
QLabel#statusCapsule_Connected {
    background-color: #DCFCE7;
    color: #16A34A;
    border-radius: 16px;
    padding: 6px 16px;
    font-weight: bold;
    border: 1px solid #BBF7D0;
}

QLabel#statusCapsule_Disconnected {
    background-color: #F1F5F9;
    color: #64748B;
    border-radius: 16px;
    padding: 6px 16px;
    font-weight: bold;
    border: 1px solid #E2E8F0;
}

QLabel#statusCapsule_Error {
    background-color: #FEE2E2;
    color: #DC2626;
    border-radius: 16px;
    padding: 6px 16px;
    font-weight: bold;
    border: 1px solid #FECACA;
}

/* Alarm Cards */
QWidget#alarmCard {
    background-color: #F8FAFC;
    border: 1px solid #DDE5F0;
    border-radius: 8px;
}

QLabel.alarm-title {
    font-size: 15px;
    font-weight: bold;
    color: #0F172A;
}

QLabel.alarm-desc {
    font-size: 13px;
    color: #475569;
}

QLabel.alarm-status-normal {
    font-weight: bold;
    color: #16A34A;
}

QLabel.alarm-status-warning {
    font-weight: bold;
    color: #F59E0B;
}

QLabel.alarm-status-danger {
    font-weight: bold;
    color: #DC2626;
}

QLabel.alarm-status-unconfigured {
    font-weight: bold;
    color: #94A3B8;
}

/* System Status Grid */
QLabel.sys-stat-label {
    color: #475569;
    font-size: 13px;
}
QLabel.sys-stat-value {
    color: #0F172A;
    font-weight: bold;
    font-size: 13px;
}

/* Checkboxes */
QCheckBox {
    spacing: 8px;
    font-weight: bold;
}
QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 1px solid #CBD5E1;
    background-color: #FFFFFF;
}
QCheckBox::indicator:checked {
    background-color: #2563EB;
    border-color: #2563EB;
}
